# Frontend Environment Variables (example)
# Copy this file to `.env` and set values accordingly. Do not commit your real .env.

# Base URL for backend API (e.g., https://api.example.com or http://localhost:8000)
REACT_APP_API_BASE_URL=http://localhost:8000

# Public site URL for redirects (used in auth email redirects if applicable)
REACT_APP_SITE_URL=http://localhost:3000

# Payment provider public key (if integrating with a provider like Stripe; optional)
REACT_APP_PAYMENT_PUBLIC_KEY=

# Toggle verbose logging in development
REACT_APP_DEBUG=false
